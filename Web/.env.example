# Copie para .env.local e preencha. O .env.local é ignorado pelo git
# (regra `*.local` no .gitignore) -- nada daqui vai parar num commit.

# ---------------------------------------------------------------------------
# Obrigatório -- o app não sobe sem estes dois.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Opcional. Bucket do Supabase Storage para uploads. Padrão: uploads
VITE_SUPABASE_UPLOAD_BUCKET=

# ---------------------------------------------------------------------------
# Contas de teste -- opcionais, só para os testes automatizados.
#
# Sem elas, tudo que depende de sessão fica invisível para os testes: criar
# anúncio, avaliar, o Dashboard, o chat, o catálogo. Todo esse caminho passa
# por RLS, e a chave publishable sozinha só enxerga o que um visitante
# enxerga.
#
# USE CONTAS DESCARTÁVEIS, criadas só para isto. A senha fica em texto neste
# arquivo. Nunca ponha aqui a sua conta real.
#
# Os testes que precisam de login se PULAM sozinhos quando estas variáveis
# não existem -- não quebram o `npm test` de quem não configurou.
#
# NÃO adicione a service role key do Supabase aqui. Ela ignora toda a RLS;
# o ganho para teste não compensa o risco de ela circular.
# ---------------------------------------------------------------------------

# Conta com papel "fornecedor" (tem anúncio, plano, catálogo)
TEST_FORNECEDOR_EMAIL=
TEST_FORNECEDOR_PASSWORD=

# Conta com papel "cliente"/"empreendedor" (compra, avalia, conversa)
TEST_CLIENTE_EMAIL=
TEST_CLIENTE_PASSWORD=

# ---------------------------------------------------------------------------
# Cloudflare Turnstile (CAPTCHA) -- Resumo.md §228. Opcional.
#
# Site key PÚBLICA (vai para o navegador; a secret NUNCA fica aqui -- ela vai
# no painel do Supabase Auth e nos secrets da Edge Function).
# Vazia = sem widget (comportamento antigo). Em desenvolvimento use a chave
# de teste em .env.development.local; em produção, a chave real do widget.
# Um build de produção com chave de teste ignora a chave e avisa no console.
# ---------------------------------------------------------------------------
VITE_TURNSTILE_SITE_KEY=

# true = o formulário de orçamento passa pela Edge Function
# submit-contact-request (Siteverify + gravação). Só depois de publicá-la e
# rodar supabase/contact-request-captcha.sql. Padrão: desligado.
VITE_TURNSTILE_CONTACT_REQUIRED=
