# Secrets da Edge Function send-emails (seções 209, 221 e 222). EXEMPLO, sem valores reais.
#
# Em produção: supabase secrets set --env-file supabase/functions/.env
# (ou painel -> Edge Functions -> Secrets).
# Local: copie para supabase/functions/.env (ignorado pelo git) e rode
#   supabase functions serve send-emails --no-verify-jwt --env-file supabase/functions/.env
# NUNCA coloque nada disto em .env.local nem em variável VITE_*: o Vite embute
# VITE_* no JavaScript do navegador.

# Brevo -> SMTP & API -> API Keys. É a API KEY (começa com xkeysib-), NÃO a
# chave SMTP (xsmtpsib-), que é só para o SMTP do Supabase Auth.
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxx

# Remetente VERIFICADO na Brevo (Senders, Domains & Dedicated IPs -> Senders).
# Aceita "Nome <email>" ou só o e-mail. Sem domínio próprio dá para verificar
# um e-mail avulso, mas a entrega é pior: o ideal é um domínio autenticado.
EMAIL_FROM=NEXAR <nao-responda@seu-dominio.com.br>
EMAIL_REPLY_TO=
APP_URL=http://localhost:5173

# disabled = nada sai | test = tudo vai para EMAIL_TEST_TO | live = destinatários reais
EMAIL_SENDING_MODE=test
EMAIL_TEST_TO=seu-email@exemplo.com

# Segredo compartilhado com o pg_cron (Vault: nexar_email_worker_secret).
# Mínimo 32 caracteres. Gere um longo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_WORKER_SECRET=

# Pagamentos só depois do gateway existir.
EMAIL_ENABLE_PAYMENT_EMAILS=false
EMAIL_BATCH_SIZE=20
EMAIL_PER_USER_PER_HOUR=10

# ---------------------------------------------------------------------------
# Edge Function submit-contact-request (Turnstile no orçamento, §228).
# Secret do widget no painel da Cloudflare (Turnstile -> widget -> Settings).
# NUNCA a de teste em produção. Teste: 1x0000000000000000000000000000000AA
# (passa), 2x...AA (falha), 3x...AA (token já usado).
TURNSTILE_SECRET_KEY=
# Hostnames aceitos no token (separados por vírgula). Vazio = não confere.
TURNSTILE_ALLOWED_HOSTNAMES=
# Origens do site para CORS (ex.: https://nexar.com.br). Vazio = qualquer.
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Edge Functions billing-checkout e asaas-webhook (Asaas, §232).
# Secrets da EDGE FUNCTION (supabase secrets set ... ou painel -> Edge
# Functions -> Secrets). NUNCA em .env.local nem em variável VITE_*.
#
# sandbox | production. Define a URL da API (fixa no código):
#   sandbox    -> https://api-sandbox.asaas.com/v3
#   production -> https://api.asaas.com/v3
ASAAS_ENVIRONMENT=
# Chave da API do MESMO ambiente: Sandbox começa com $aact_hmlg_, produção
# com $aact_prod_. Prefixo errado = a função recusa. (Asaas -> Integrações
# -> Chaves de API, na conta Sandbox em https://sandbox.asaas.com.)
ASAAS_API_KEY=
# Token do webhook: OUTRO segredo, >= 32 caracteres, nunca a chave da API.
# Gere: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# e cole o mesmo valor no painel do Asaas (Webhooks -> Token de autenticação).
ASAAS_WEBHOOK_TOKEN=
# Edge Function billing-reconcile (§233): segredo do agendador, >= 32
# caracteres, diferente da chave da API e do ASAAS_WEBHOOK_TOKEN.
BILLING_RECONCILE_SECRET=
